{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "image",
    "replicaCount",
    "ports",
    "frontend",
    "sqlite",
    "server",
    "ingress"
  ],
  "definitions": {
    "image": {
      "type": "object",
      "required": [
        "repository",
        "tag",
        "pullPolicy"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^\\S+$"
        },
        "tag": {
          "type": "string",
          "pattern": "^\\S+$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    }
  },
  "properties": {
    "image": {
      "$ref": "#/definitions/image"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "ports": {
      "type": "object",
      "required": [
        "http",
        "grpc",
        "debug"
      ],
      "properties": {
        "http": {
          "$ref": "#/definitions/port"
        },
        "grpc": {
          "$ref": "#/definitions/port"
        },
        "debug": {
          "$ref": "#/definitions/port"
        }
      }
    },
    "frontend": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "replicaCount": {
          "type": "integer",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "enabled": {
                "const": true
              }
            },
            "required": [
              "enabled"
            ]
          },
          "then": {
            "required": [
              "image"
            ],
            "properties": {
              "image": {
                "$ref": "#/definitions/image"
              }
            }
          }
        }
      ]
    },
    "sqlite": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "server": {
      "type": "object",
      "properties": {
        "allowRemoteDebug": {
          "type": "boolean"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRef": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            },
            "sectionName": {
              "type": "string"
            }
          }
        },
        "routes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "hostnames",
              "backend"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
              },
              "hostnames": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^(\\*\\.)?([a-z0-9]([-a-z0-9]*[a-z0-9])?\\.)*[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                }
              },
              "backend": {
                "type": "string",
                "enum": [
                  "server",
                  "frontend"
                ]
              },
              "pathPrefix": {
                "type": "string",
                "pattern": "^/"
              }
            }
          }
        }
      },
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        },
        "required": [
          "enabled"
        ]
      },
      "then": {
        "required": [
          "parentRef",
          "routes"
        ],
        "properties": {
          "parentRef": {
            "required": [
              "name"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^\\S+$"
              }
            }
          },
          "routes": {
            "minItems": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "not": {
        "required": [
          "gateway",
          "ingress"
        ],
        "properties": {
          "gateway": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          },
          "ingress": {
            "required": [
              "enabled"
            ],
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": [
          "gateway"
        ],
        "properties": {
          "gateway": {
            "required": [
              "enabled",
              "routes"
            ],
            "properties": {
              "enabled": {
                "const": true
              },
              "routes": {
                "contains": {
                  "required": [
                    "backend"
                  ],
                  "properties": {
                    "backend": {
                      "const": "frontend"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "frontend": {
            "properties": {
              "enabled": {
                "const": true
              }
            }
          }
        }
      }
    }
  ]
}
