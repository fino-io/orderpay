{
  "annotations": { "list": [] },
  "editable": false,
  "graphTooltip": 1,
  "id": null,
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 95 },
              { "color": "green", "value": 100 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "The percentage of scraped instances currently reachable across the selected services.",
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * avg(up{job=~\"$job\"})",
          "instant": true,
          "legendFormat": "Healthy instances",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Fleet Availability",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "decimals": 2, "unit": "reqps" }, "overrides": [] },
      "description": "Current request rate across the selected service instances.",
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate({__name__=~\".+_(http|grpc)_server_requests_total\",job=~\"$job\"}[$__rate_interval]))",
          "instant": true,
          "legendFormat": "Requests",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "The highest error percentage among the selected services.",
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(100 * sum by (job) (rate({__name__=~\".+_http_server_requests_total\",job=~\"$job\",status_class=\"5xx\"}[$__rate_interval]) or rate({__name__=~\".+_grpc_server_requests_total\",job=~\"$job\",code!=\"OK\"}[$__rate_interval])) / clamp_min(sum by (job) (rate({__name__=~\".+_(http|grpc)_server_requests_total\",job=~\"$job\"}[$__rate_interval])), 0.000001))",
          "instant": true,
          "legendFormat": "Errors",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Worst Service Error Rate",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 3,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.5 }, { "color": "red", "value": 1 }] },
          "unit": "s"
        },
        "overrides": []
      },
      "description": "The highest P95 request latency among the selected services.",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 8,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "max(histogram_quantile(0.95, sum by (job, le) (rate({__name__=~\".+_(http|grpc)_server_request_duration_seconds_bucket\",job=~\"$job\"}[$__rate_interval]))))",
          "instant": true,
          "legendFormat": "P95",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Worst Service P95 Latency",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "description": "Request throughput by service instance.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 5 },
      "id": 4,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (job) (rate({__name__=~\".+_(http|grpc)_server_requests_total\",job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Request Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 }] },
          "unit": "percent"
        },
        "overrides": []
      },
      "description": "Error percentage by service over time.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 5 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum by (job) (rate({__name__=~\".+_http_server_requests_total\",job=~\"$job\",status_class=\"5xx\"}[$__rate_interval]) or rate({__name__=~\".+_grpc_server_requests_total\",job=~\"$job\",code!=\"OK\"}[$__rate_interval])) / clamp_min(sum by (job) (rate({__name__=~\".+_(http|grpc)_server_requests_total\",job=~\"$job\"}[$__rate_interval])), 0.000001)",
          "legendFormat": "{{job}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Error Rate",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "description": "P95 and P99 request latency by service instance.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 5 },
      "id": 9,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (job, le) (rate({__name__=~\".+_(http|grpc)_server_request_duration_seconds_bucket\",job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{job}} P95",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (job, le) (rate({__name__=~\".+_(http|grpc)_server_request_duration_seconds_bucket\",job=~\"$job\"}[$__rate_interval])))",
          "legendFormat": "{{job}} P99",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Latency (P95 / P99)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "description": "Resident memory by service instance.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 13 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "process_resident_memory_bytes{job=~\"$job\"}",
          "legendFormat": "{{job}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Resident Memory",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "description": "Current Go goroutine count by service instance.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 13 },
      "id": 7,
      "options": {
        "legend": { "calcs": ["lastNotNull"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "go_goroutines{job=~\"$job\"}",
          "legendFormat": "{{job}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Goroutines",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "description": "Process CPU usage by service. Values above 100% indicate more than one CPU core in use.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 13 },
      "id": 10,
      "options": {
        "legend": { "calcs": ["lastNotNull", "mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "100 * sum by (job) (rate(process_cpu_seconds_total{job=~\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{job}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Process CPU Usage",
      "type": "timeseries"
    }
  ],
  "refresh": "15s",
  "schemaVersion": 39,
  "tags": ["services", "metrics"],
  "templating": {
    "list": [
      {
        "allValue": ".*",
        "current": { "selected": true, "text": "All", "value": "$__all" },
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up{job=~\"orderpay-server\"}, job)",
        "hide": 0,
        "includeAll": true,
        "label": "Service",
        "multi": true,
        "name": "job",
        "options": [],
        "query": { "query": "label_values(up{job=~\"orderpay-server\"}, job)", "refId": "PrometheusVariableQueryEditor-VariableQuery" },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1,
        "type": "query"
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Service Overview",
  "uid": "service-overview",
  "version": 1,
  "weekStart": ""
}
