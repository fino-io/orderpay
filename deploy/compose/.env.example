IMAGE_REPOSITORY='orderpay'

# Application images built by GoReleaser snapshot.
ORDERPAY_SERVER_IMAGE=orderpay-server:latest-amd64
ORDERPAY_FRONTEND_IMAGE=orderpay-frontend:latest-amd64
ORDERPAY_FRONTEND_PORT=8082

LOKI_IMAGE_REGISTRY=docker.io
LOKI_IMAGE_REPOSITORY=grafana
LOKI_IMAGE_NAME=loki
LOKI_IMAGE_TAG=3.7.6
LOKI_PORT=3100

TEMPO_IMAGE_REGISTRY=docker.io
TEMPO_IMAGE_REPOSITORY=grafana
TEMPO_IMAGE_NAME=tempo
TEMPO_IMAGE_TAG=3.0.2

TEMPO_RETENTION=168h

ALLOY_IMAGE_REGISTRY=docker.io
ALLOY_IMAGE_REPOSITORY=grafana
ALLOY_IMAGE_NAME=alloy
ALLOY_IMAGE_TAG=v1.18.1
ALLOY_HTTP_PORT=12345
ALLOY_OTLP_GRPC_PORT=4317
ALLOY_OTLP_HTTP_PORT=4318

PROMETHEUS_IMAGE_REGISTRY=docker.io
PROMETHEUS_IMAGE_REPOSITORY=prom
PROMETHEUS_IMAGE_NAME=prometheus
PROMETHEUS_IMAGE_TAG=v3.14.0
PROMETHEUS_PORT=9090

GRAFANA_IMAGE_REGISTRY=docker.io
GRAFANA_IMAGE_REPOSITORY=grafana
GRAFANA_IMAGE_NAME=grafana
GRAFANA_IMAGE_TAG=13.2.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Set a unique strong password before deployment.
GRAFANA_ADMIN_PASSWORD=change-me-before-deploy
GRAFANA_ROOT_URL=http://127.0.0.1:8082/monitor/

# Application listeners and debug mappings for Docker Compose.
SERVER_HTTP_PORT=31101
SERVER_GRPC_PORT=31102
SERVER_DEBUG_PORT=31103

# Generated once; keep the key across restarts.
PAGINATION_ENCODED_KEY=SFmaiUoW7YslIaUdW6VriAc3WbCPP2yQRb4Cswk+Upk
