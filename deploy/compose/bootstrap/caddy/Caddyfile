:80 {
	log {
		output stdout
		format json
	}

	encode zstd gzip

	@monitorRoot path /monitor
	redir @monitorRoot /monitor/ 308

	handle /monitor/* {
		reverse_proxy grafana:3000
	}

	@api path {$API_PREFIX} {$API_PREFIX}/*
	handle @api {
		reverse_proxy {$APP_HOST}:{$APP_PORT}
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@documents not path /assets/* {$API_PREFIX} {$API_PREFIX}/*
	header @documents Cache-Control "no-cache"

	handle {
		root * /usr/share/caddy
		try_files {path} {path}/ /index.html
		file_server
	}
}
