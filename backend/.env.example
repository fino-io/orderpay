# Copy to .env for local execution. Environment variables already set by the
# shell or container take precedence.
OTEL_ENDPOINT=127.0.0.1:4318

SERVER_HTTP_PORT=31101
SERVER_GRPC_PORT=31102
SERVER_DEBUG_PORT=31103

# Generated once; keep the key across restarts.
PAGINATION_ENCODED_KEY=op5RN+7XER8yBH7LQHXbXZaGhF73pXtjnpogv6c0lpE

# Nacos first, local configs fallback. Empty address uses local files directly.
# API host:port (not console URL). SDK gRPC port must equal API port + 1000.
NACOS_SERVER_ADDR=
# Public namespace ID is empty. Use namespace IDs, not display names.
NACOS_NAMESPACE_ID=
NACOS_GROUP=DEFAULT_GROUP
# Empty selects <service>.yaml; leave empty when services share this environment.
NACOS_DATA_ID=
NACOS_USERNAME=
NACOS_PASSWORD=

# Explicit service-key map; no built-in account or payment channel is enabled.
# Replace each key with a private random value of at least 32 characters.
# ORDERPAY_API_KEYS='{"<merchant-secret>":{"merchantId":"<merchant-uuid>"},"<admin-secret>":{"admin":true}}'
ORDERPAY_API_KEYS=
